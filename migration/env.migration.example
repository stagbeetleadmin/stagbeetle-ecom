# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to  migration/.env.migration  and fill every value in.
#
#     cp migration/env.migration.example migration/.env.migration
#
# migration/.env.migration is gitignored — it holds live credentials (DB
# passwords, service_role keys). Keep it out of git and delete it once the
# migration is done and verified.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres connection strings ─────────────────────────────────────────────
# Copy the *Session pooler* URI from each project's dashboard:
#     Dashboard → Connect (top bar) → "Session pooler"
# NOT "Transaction pooler" — pg_dump cannot run through transaction mode (6543).
# The pooler host (aws-*.pooler.supabase.com) also sidesteps the IPv6-only
# restriction on the direct db.<ref>.supabase.co:5432 endpoint, which most
# home/office ISPs in India can't reach.
#
# The pooler username is  postgres.<project-ref>  — the dashboard shows the
# exact string; copy it verbatim.
#
# If the DB password contains any of  @ : / ? # [ ]  it MUST be percent-encoded
# in the URI:   @ → %40    : → %3A    / → %2F    # → %23
# e.g. a password  Secret@1998  is written  Secret%401998
#
# OLD = current Singapore project (lpkasszpjklrmwugeupp)
# NEW = new Mumbai project        (uzhdhxfcvptgowkuupmz)

OLD_DB_URL="postgresql://postgres.lpkasszpjklrmwugeupp:PASSWORD_URL_ENCODED@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
NEW_DB_URL="postgresql://postgres.uzhdhxfcvptgowkuupmz:PASSWORD_URL_ENCODED@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Storage copy + verification (migrate-storage.mjs / verify.mjs) ──────────
# service_role secret from:  Dashboard → Settings → API → Project API keys →
# "service_role" (click to reveal). On newer projects this is an "sb_secret_…"
# key under Settings → API Keys. It bypasses RLS — never commit it, never ship
# it to the browser.

OLD_SUPABASE_URL="https://lpkasszpjklrmwugeupp.supabase.co"
OLD_SERVICE_ROLE_KEY=""

NEW_SUPABASE_URL="https://uzhdhxfcvptgowkuupmz.supabase.co"
NEW_SERVICE_ROLE_KEY=""

# Comma-separated buckets to copy. Only garment-images is used by the app today.
BUCKETS="garment-images"

# ── Used by rewrite-urls.sql ───────────────────────────────────────────────
# (Project refs only — the SQL swaps every "<OLD_REF>.supabase.co" for
# "<NEW_REF>.supabase.co" in stored image URLs.)
OLD_REF="lpkasszpjklrmwugeupp"
NEW_REF="uzhdhxfcvptgowkuupmz"
